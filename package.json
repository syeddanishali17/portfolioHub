{
  "name": "danish-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src tests scripts cv",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cv": "node scripts/export-cv.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "portrait": "python scripts/prepare_portrait.py",
    "audit:a11y": "node scripts/audit-a11y.mjs http://localhost:4173"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
